{
    "name": "@tdev/core",
    "workspaces": [
        "packages/**",
        "."
    ],
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "start": "NODE_OPTIONS=--max-old-space-size=12288 docusaurus start",
        "start:fast": "bash -c 'export NODE_OPTIONS=--max-old-space-size=12288 INCLUDE=\"$(IFS=,; echo \"$*\")\" ARCHIVES=0; exec docusaurus start' --",
        "start:dev": "concurrently --raw --kill-others 'NODE_OPTIONS=--max-old-space-size=12288 docusaurus start' 'sleep 1s && tsx updateSync/packageDocsSync/watch.ts --src packages --dest docs/Packages'",
        "prebuild": "tsx updateSync/packageDocsSync/preBuild.ts --src packages --dest docs/Packages && yarn workspace @tdev/material-sync sync",
        "build": "docusaurus build",
        "postbuild": "yarn workspace @tdev/material-sync restore",
        "prebuild:dev": "tsx updateSync/packageDocsSync/preBuild.ts --src packages --dest docs/Packages",
        "build:dev": "docusaurus build",
        "sync": "yarn workspace @tdev/material-sync sync",
        "sync:secure": "yarn workspace @tdev/material-sync sync:secure",
        "remove": "yarn workspace @tdev/material-sync run remove",
        "precleanup": "yarn workspace @tdev/material-sync restore",
        "cleanup": "yarn workspace @tdev/material-sync cleanup",
        "postremove": "yarn workspace @tdev/material-sync sync",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "typecheck": "tsc",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest --coverage --configLoader runner",
        "updateTdev": "tsx updateSync/updateTdev.ts",
        "add": "yarn workspace @tdev/material-sync run add",
        "postadd": "yarn workspace @tdev/material-sync sync",
        "addClass": "yarn workspace @tdev/material-sync run addClass",
        "present": "gulp serve"
    },
    "dependencies": {
